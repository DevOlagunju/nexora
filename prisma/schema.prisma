// Nexora  -  Nigeria crypto & gift card exchange
// Hybrid ops: admin-verified trades + structured automation hooks

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// What a staff member (role ADMIN) is allowed to do. See src/lib/permissions.ts.
enum StaffRole {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  TRADING_OFFICER
  FINANCE_OFFICER
  COMPLIANCE_OFFICER
  CUSTOMER_SUPPORT
  AUDITOR
}

enum KycStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum AssetKind {
  CRYPTO
  GIFTCARD
}

enum TradeSide {
  SELL
  BUY
}

enum OrderStatus {
  DRAFT
  AWAITING_DEPOSIT
  UNDER_REVIEW
  APPROVED
  PAYOUT_SENT
  COMPLETED
  REJECTED
  CANCELLED
}

/// Where a sell order's Naira goes: straight to the bank, or into the Nexora wallet.
enum PayoutMethod {
  BANK
  WALLET
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String     @unique
  passwordHash String
  fullName     String
  role         Role       @default(USER)
  /// Set only for staff (role ADMIN). A staff account without one can view the desk but change nothing.
  staffRole    StaffRole?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Naira wallet balance: a copy of the customer's ledger account balance, kept in step by the
  /// database. Application code never writes it (see the ledger migration).
  walletBalanceNgn   Decimal   @default(0) @db.Decimal(18, 2)
  /// bcrypt hash of the 4-digit transaction PIN (withdrawals).
  transactionPinHash String?
  pinFailedCount     Int       @default(0)
  pinLockedUntil     DateTime?
  referralCode       String?   @unique
  referredById       String?

  referredBy          User?                @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]               @relation("Referrals")
  walletEntries       WalletEntry[]
  withdrawals         Withdrawal[]
  notifications       Notification[]
  rateAlerts          RateAlert[]
  payments            Payment[]
  kyc                 KycProfile?
  cryptoOrders        CryptoOrder[]
  giftOrders          GiftCardOrder[]
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  idempotencyKeys     IdempotencyKey[]
  ledgerAccounts      LedgerAccount[]
  quotes              Quote[]
  depositAddresses    DepositAddress[]
}

/// Makes a retried API request safe: the first response for a key is stored and replayed,
/// so a repeated "create order" or "withdraw" never happens twice.
model IdempotencyKey {
  id             String   @id @default(cuid())
  userId         String
  key            String
  /// sha256 of method + path + body: the same key with a different request is rejected.
  requestHash    String
  /// null while the first request is still running.
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  bvnLast4        String?
  ninLast4        String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  /// Paystack/NIP bank code chosen from the bank list (exact payouts, no name guessing).
  bankCode        String?
  /// True when accountName came from a live bank lookup, not typed by the customer.
  accountVerified Boolean   @default(false)
  /// Does the bank account name match the customer's registered name? null = not checked.
  nameMatch       Boolean?
  status          KycStatus @default(UNVERIFIED)
  reviewNote      String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rate {
  id            String    @id @default(cuid())
  kind          AssetKind
  symbol        String
  displayName   String
  /// NGN per 1 unit (crypto coin or $1 gift card face value)
  sellRateNgn   Decimal   @db.Decimal(18, 4)
  buyRateNgn    Decimal   @db.Decimal(18, 4)
  minAmount     Decimal   @default(1) @db.Decimal(36, 18)
  maxAmount     Decimal?  @db.Decimal(36, 18)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  /// Crypto: how far below the market mid customers sell to Nexora, in percent. The margin is
  /// built into the rate (no separate trading fee). Applied when rates are synced from the market.
  sellSpreadPct Decimal   @default(1) @db.Decimal(6, 3)
  /// Crypto: how far above the market mid customers buy from Nexora, in percent.
  buySpreadPct  Decimal   @default(1) @db.Decimal(6, 3)
  /// Crypto: the market mid (NGN per unit) the desk rates were last synced from, and when.
  marketRateNgn Decimal?  @db.Decimal(18, 4)
  marketRateAt  DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  @@unique([kind, symbol])
}

/// DEPRECATED: replaced by AssetNetwork (the asset and network registry). Its rows were copied
/// there; nothing reads or writes this table any more. Kept for one release, then dropped.
model PlatformWallet {
  id        String   @id @default(cuid())
  symbol    String   @unique
  network   String
  address   String
  isActive  Boolean  @default(true)
  /// Ops allowlist note (e.g. "TRC20 only - verify memo")
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CryptoOrder {
  id                 String       @id @default(cuid())
  reference          String       @unique
  userId             String
  symbol             String
  network            String
  side               TradeSide
  amountCrypto       Decimal      @db.Decimal(36, 18)
  rateNgn            Decimal      @db.Decimal(18, 4)
  /// The market mid at the time of the order (from its quote, else the last sync). Null when unknown.
  /// What the trade earned: (market - rate) x amount on a sell, (rate - market) x amount on a buy.
  marketRateNgn      Decimal?     @db.Decimal(18, 4)
  amountNgn          Decimal      @db.Decimal(18, 2)
  depositAddress     String?
  /// Where we send crypto when user is buying
  userReceiveAddress String?
  txHash             String?
  bankName           String?
  accountNumber      String?
  accountName        String?
  /// User bank payment reference when buying with NGN
  paymentRef         String?
  status             OrderStatus  @default(AWAITING_DEPOSIT)
  adminNote          String?
  payoutRef          String?
  payoutMethod       PayoutMethod @default(BANK)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  completedAt        DateTime?

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deposits BlockchainDeposit[]
}

model GiftCardOrder {
  id                String        @id @default(cuid())
  reference         String        @unique
  userId            String
  brand             String
  /// ISO 3166 alpha-2 for orders since the gift card rates migration (older rows were converted).
  country           String        @default("US")
  /// Null on orders placed before card types existed.
  cardType          GiftCardType?
  faceValueUsd      Decimal       @db.Decimal(12, 2)
  rateNgn           Decimal       @db.Decimal(18, 4)
  amountNgn         Decimal       @db.Decimal(18, 2)
  /// AES-GCM ciphertext  -  never store raw gift card codes
  cardCodeEncrypted String
  cardCodeIv        String
  imageNote         String?
  status            OrderStatus   @default(UNDER_REVIEW)
  adminNote         String?
  payoutRef         String?
  payoutMethod      PayoutMethod  @default(BANK)
  bankName          String?
  accountNumber     String?
  accountName       String?
  /// Auto heuristics for desk (high face, burst volume, etc.)
  fraudFlag         Boolean       @default(false)
  /// What the desk got for the card when it redeemed or resold it, entered on completion. Earnings = this - amountNgn.
  redeemedNgn       Decimal?      @db.Decimal(18, 2)
  fraudNote         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  completedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  meta      String?
  ipHash    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// Append-only wallet ledger. `reference` is unique so every credit/debit happens at most once
/// (e.g. "order:NXC-..", "wd:NXW-..", "wd-refund:NXW-..", "referral:<userId>").
model WalletEntry {
  id          String          @id @default(cuid())
  userId      String
  direction   LedgerDirection
  amountNgn   Decimal         @db.Decimal(18, 2)
  reference   String          @unique
  description String
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Withdrawal {
  id            String           @id @default(cuid())
  reference     String           @unique
  userId        String
  amountNgn     Decimal          @db.Decimal(18, 2)
  feeNgn        Decimal          @default(0) @db.Decimal(18, 2)
  bankName      String
  accountNumber String
  accountName   String
  bankCode      String?
  status        WithdrawalStatus @default(PENDING)
  payoutRef     String?
  adminNote     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  processedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

enum AlertDirection {
  ABOVE
  BELOW
}

/// "Tell me when USDT sell rate goes above N1,450". One-shot: deactivates when it fires.
model RateAlert {
  id          String         @id @default(cuid())
  userId      String
  kind        AssetKind
  symbol      String
  side        TradeSide
  direction   AlertDirection
  targetNgn   Decimal        @db.Decimal(18, 4)
  isActive    Boolean        @default(true)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive, kind, symbol])
  @@index([userId, createdAt])
}

enum PaymentPurpose {
  WALLET_FUNDING
  CRYPTO_BUY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

/// Naira collected through the payment gateway (card incl. virtual cards, bank transfer, USSD, pay-with-bank).
/// Marked SUCCESS only after the server re-verifies with the provider; never on the redirect alone.
model Payment {
  id           String         @id @default(cuid())
  reference    String         @unique
  userId       String
  purpose      PaymentPurpose
  /// CryptoOrder.id when purpose is CRYPTO_BUY
  orderId      String?
  /// Amount we asked for
  amountNgn    Decimal        @db.Decimal(18, 2)
  /// Amount the provider says was actually paid
  paidNgn      Decimal?       @db.Decimal(18, 2)
  provider     String
  status       PaymentStatus  @default(PENDING)
  channel      String?
  providerNote String?
  paidAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------- double-entry ledger

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

/// One account in the chart of accounts. `code` is its stable name, e.g. "customer:<userId>:NGN"
/// or "asset:provider_clearing:NGN" (see src/lib/ledger/accounts.ts).
model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  type      LedgerAccountType
  currency  String            @default("NGN")
  /// Set for a customer's own account (what Nexora owes that customer).
  userId    String?
  /// Running total of this account's entries, in its normal direction. Maintained by the
  /// database from LedgerEntry rows; nothing else may change it.
  balance   Decimal           @default(0) @db.Decimal(18, 2)
  createdAt DateTime          @default(now())

  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@index([userId])
}

/// One financial event. Its entries always balance (debits = credits), and once written
/// neither it nor its entries can be changed or deleted: a mistake is fixed by a new
/// transaction that reverses it (`reversesId`).
model LedgerTransaction {
  id          String   @id @default(cuid())
  /// Unique per event, so the same event can never be posted twice.
  reference   String   @unique
  /// deposit | purchase | purchase_refund | sale_proceeds | withdrawal | withdrawal_refund | withdrawal_paid | referral_bonus | adjustment
  kind        String
  description String
  /// Who or what caused it: "system", "customer:<id>", "admin:<id>", "provider:paystack".
  source      String   @default("system")
  /// The transaction this one reverses, if it is a reversal.
  reversesId  String?  @unique
  postedAt    DateTime @default(now())

  reverses   LedgerTransaction? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LedgerTransaction? @relation("Reversal")
  entries    LedgerEntry[]

  @@index([kind, postedAt])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(18, 2)
  createdAt     DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
}

// ---------------------------------------------------------------- pricing

/// A price promise: this rate for this amount, until `expiresAt`. An order created from a
/// quote uses the locked rate even if the desk rate has moved since. Used at most once.
model Quote {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String
  kind           AssetKind
  side           TradeSide
  symbol         String
  /// Crypto quantity, or gift card face value in USD.
  amount         Decimal       @db.Decimal(36, 18)
  /// Gift cards only: the variant the price was taken from.
  country        String?
  cardType       GiftCardType?
  /// The locked rate, in Naira per unit.
  rateNgn        Decimal       @db.Decimal(18, 4)
  /// Crypto: the market mid the desk rate was set from when this quote was made (for earnings).
  marketRateNgn  Decimal?      @db.Decimal(18, 4)
  feeNgn         Decimal       @default(0) @db.Decimal(18, 2)
  /// What the customer receives (sell) or pays (buy), fees included.
  amountNgn      Decimal       @db.Decimal(18, 2)
  /// Where the rate came from and when it was last set, so a quote can be explained later.
  rateSource     String        @default("desk")
  rateUpdatedAt  DateTime
  expiresAt      DateTime
  acceptedAt     DateTime?
  /// Reference of the order created from this quote.
  orderReference String?       @unique
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------- asset and network registry

/// A blockchain network the desk can receive crypto on or send it out on.
/// `code` is what customers see and what orders record, e.g. "TRC20", "ERC20", "BEP20", "BTC".
model BlockchainNetwork {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
  /// An address on this network must match this pattern (checked on the server).
  addressPattern       String
  /// Plain words for the pattern, shown when an address is rejected.
  addressHint          String
  /// Link to a transaction, with "{tx}" where the hash goes.
  explorerTxUrl        String?
  /// Confirmations a new asset on this network starts with; each asset can then set its own.
  defaultConfirmations Int      @default(1)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assets           AssetNetwork[]
  depositAddresses DepositAddress[]
}

/// One crypto asset on one network: where customers send it when they sell, whether the desk
/// can send it out when they buy, and how many confirmations a deposit needs. The asset's price
/// stays on Rate; this decides where and how it can move.
model AssetNetwork {
  id                 String   @id @default(cuid())
  /// Matches Rate.symbol for kind CRYPTO.
  symbol             String
  networkId          String
  /// Where customers send this asset when they sell it.
  depositAddress     String
  /// Memo / tag the deposit must carry on networks that need one.
  depositMemo        String?
  /// Confirmations a deposit needs before the desk treats it as received.
  confirmations      Int
  /// Customers may sell (send in) this asset on this network.
  depositsEnabled    Boolean  @default(true)
  /// The desk may send this asset out on this network (customer purchases).
  withdrawalsEnabled Boolean  @default(true)
  /// The network used when a request does not name one. One per asset.
  isDefault          Boolean  @default(false)
  /// Shown to customers next to the deposit address (network rules, warnings).
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  network BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)

  @@unique([symbol, networkId])
  @@index([symbol])
}

// ---------------------------------------------------------------- gift card rates

enum GiftCardType {
  /// A code sent by email or shown in an app.
  ECODE
  /// A plastic card; the code is on the back.
  PHYSICAL
}

/// The desk's price for one brand, from one country, of one card type, per US dollar of face
/// value. The brand itself (name, on/off) stays on Rate; this decides what each variant pays.
model GiftCardRate {
  id            String       @id @default(cuid())
  /// Matches Rate.symbol for kind GIFTCARD.
  brand         String
  /// ISO 3166 alpha-2 country the card was issued in, e.g. "US", "GB".
  country       String
  cardType      GiftCardType
  /// Naira per US dollar of face value.
  rateNgn       Decimal      @db.Decimal(18, 4)
  minFaceUsd    Decimal      @db.Decimal(12, 2)
  maxFaceUsd    Decimal?     @db.Decimal(12, 2)
  /// Allowed face values, comma separated (e.g. "25,50,100"). Empty means any value in range.
  denominations String?
  isActive      Boolean      @default(true)
  /// The variant used when a request names no country or card type. One per brand. The brand's
  /// headline rate on Rate is kept equal to this variant's.
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([brand, country, cardType])
  @@index([brand])
}

// ---------------------------------------------------------------- blockchain deposits

/// Where a deposit stands. PENDING: seen, waiting for confirmations. CREDITED: confirmed and matched to
/// an order. The rest are exceptions the desk must look at; RESOLVED is an exception a person closed.
enum DepositStatus {
  PENDING
  CREDITED
  UNDERPAID
  OVERPAID
  UNMATCHED
  WRONG_ASSET
  REVERSED
  RESOLVED
}

/// A customer's own deposit address for one asset on one network, issued by the deposit provider.
/// A deposit to it is matched to that customer without anyone pasting a transaction hash.
model DepositAddress {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  networkId   String
  address     String
  memo        String?
  /// Which deposit provider issued it ("simulated" for local testing).
  provider    String
  providerRef String?
  createdAt   DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  network BlockchainNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)

  @@unique([userId, symbol, networkId])
  @@unique([networkId, address])
}

/// One incoming on-chain transfer, as reported by the deposit provider. Updated as confirmations arrive.
model BlockchainDeposit {
  id            String        @id @default(cuid())
  provider      String
  /// Network code, e.g. "TRC20".
  network       String
  /// What arrived (can differ from what the address is for: WRONG_ASSET).
  symbol        String
  txHash        String
  /// Position inside the transaction (output or log index), so one transaction can pay several addresses.
  txIndex       String        @default("0")
  toAddress     String
  fromAddress   String?
  amount        Decimal       @db.Decimal(36, 18)
  confirmations Int           @default(0)
  status        DepositStatus @default(PENDING)
  /// The customer the address belongs to; null when nobody's address received it.
  userId        String?
  /// The sell order it paid; null until matched.
  orderId       String?
  note          String?
  firstSeenAt   DateTime      @default(now())
  confirmedAt   DateTime?
  resolvedAt    DateTime?
  resolvedBy    String?
  updatedAt     DateTime      @updatedAt

  order CryptoOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([network, txHash, txIndex])
  @@index([status, firstSeenAt])
  @@index([orderId])
}

/// Every provider webhook, stored before it is processed (specification section 11), so nothing is
/// lost if processing fails and a repeated delivery is recognised.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  signatureOk Boolean
  payload     String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
}
