# Copy to `.env` and replace every value before running or deploying.
# Never commit the real `.env` file.
# Staging template: `.env.staging.example` - ship checklist: `docs/SHIP.md`

# PostgreSQL (required). Local: `docker compose up -d postgres`, then `npm run db:deploy`.
DATABASE_URL="postgresql://nexora:nexora@localhost:5432/nexora"
# If 5432 is already used on your machine, pick another host port here and in DATABASE_URL.
# POSTGRES_PORT="5433"

AUTH_SECRET="replace-with-long-random-string-at-least-32-chars"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-strong-password"
NEXT_PUBLIC_APP_NAME="Nexora"
# WhatsApp digits with country code (opens from failed orders)
NEXT_PUBLIC_SUPPORT_WHATSAPP="2347032743929"

# Buy-crypto NGN desk account (shown to customers)
PLATFORM_BANK_NAME="Your Bank"
PLATFORM_BANK_ACCOUNT="0123456789"
PLATFORM_BANK_ACCOUNT_NAME="Nexora Limited"

# Daily trade caps (NGN) + gift fraud heuristics
DAILY_CRYPTO_SELL_LIMIT_NGN="5000000"
DAILY_CRYPTO_BUY_LIMIT_NGN="5000000"
DAILY_GIFT_SELL_LIMIT_NGN="2000000"
DAILY_ORDER_COUNT_LIMIT="25"
GIFT_FRAUD_FACE_USD="500"

# Optional: Slack/Discord webhook for desk alerts
# ADMIN_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Paystack: instant payment confirmation (card incl. virtual cards, transfer, USSD, pay-with-bank)
# for wallet top-ups and card-paid buys, plus Transfers for NGN payouts.
# Without a key: dev uses a built-in TEST checkout (/pay/test/...); production hides card payments.
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_DEFAULT_BANK_CODE="058"

# Optional: KYC provider (default = manual desk review)
# KYC_PROVIDER="manual"
# KYC_API_KEY=""

# Optional: hourly desk rate sync - GET /api/cron/sync-rates
# CRON_SECRET="long-random-cron-secret"

# Generate AUTH_SECRET / ENCRYPTION_KEY / CRON_SECRET with: npm run secrets:generate
# Production refuses to boot with the example AUTH_SECRET / ENCRYPTION_KEY above.

# Recommended in production: shared rate limits across instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# Browser origins allowed to call /api (Expo web, admin tools). Native apps need nothing.
# CORS_ALLOWED_ORIGINS="https://app.yourdomain.com"

# Postgres pool size per instance (default 10)
# DATABASE_POOL_MAX="10"

# Paystack webhook (charge.success -> payment confirmed instantly; transfer success/failure -> order status):
#   https://yourdomain.com/api/webhooks/paystack  (signed with PAYSTACK_SECRET_KEY)
# Safety net for missed webhooks / closed browsers, run every 1-5 min:
#   GET /api/cron/reconcile-payments  (Authorization: Bearer $CRON_SECRET)

# Optional: email via Resend (password reset + order status)
# RESEND_API_KEY=""
# NOTIFY_FROM_EMAIL="Nexora <orders@yourdomain.com>"
# Public site URL used in password-reset emails and as the payment return page.
# REQUIRED in production for payments (otherwise the request Host header is used).
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# --- Card / instant-transfer top-ups (optional; defaults shown) ---
# FUNDING_MIN_NGN="100"
# FUNDING_MAX_NGN="5000000"
# PAYMENT_ABANDON_HOURS="48"            # unpaid checkouts are closed after this

# --- Naira wallet, withdrawals, referrals (all optional; defaults shown) ---
# WALLET_MIN_WITHDRAWAL_NGN="1000"
# WALLET_MAX_WITHDRAWAL_NGN="2000000"
# WALLET_WITHDRAWAL_FEE_NGN="100"       # flat fee per withdrawal, charged on top (Jeroid publishes ₦100)
# Trading has no separate fee: the margin is the spread built into each desk rate (Admin -> Rates).

# Blockchain deposits (docs/DEPOSITS.md). DEPOSIT_PROVIDER is one of:
#   shkeeper   your self-hosted SHKeeper server (free, open source) - use this for real money
#   simulated  free local testing, the default outside production; refused in production
#   none       off: customers send to the desk's shared address and paste the transaction hash
# DEPOSIT_PROVIDER="simulated"
# DEPOSIT_AMOUNT_TOLERANCE_PCT="0.1"        # a deposit this close to the order amount counts as exact
# SIMULATED_DEPOSIT_SECRET=""               # signs simulated webhooks; a built-in value is used if unset

# SHKeeper (DEPOSIT_PROVIDER="shkeeper"). Also needs NEXT_PUBLIC_APP_URL: SHKeeper calls back
#   $NEXT_PUBLIC_APP_URL/api/v1/webhooks/shkeeper
# SHKEEPER_URL="https://pay.yourdomain.com"   # your SHKeeper server, https in production
# SHKEEPER_API_KEY=""                          # SHKeeper admin -> Wallets -> Manage -> API key
# SHKEEPER_WEBHOOK_SECRET=""                   # only if your SHKeeper signs callbacks with a separate secret; defaults to the API key
# SHKEEPER_CRYPTO_NAMES=""                     # extra/changed coin names, e.g. "SOL/SOL=SOL"; see GET $SHKEEPER_URL/api/v1/crypto
# REFERRAL_BONUS_NGN="1000"             # paid to the referrer once; 0 disables referrals
# REFERRAL_MIN_TRADE_NGN="20000"        # referred user's completed sells needed to earn it

# Quotes (locked prices). Defaults shown.
# QUOTE_TTL_SECONDS="120"                       # how long a quote stays valid (15-900)
# QUOTE_MAX_CRYPTO_RATE_AGE_MINUTES="360"       # refuse to quote from a crypto rate older than this
# QUOTE_MAX_GIFT_RATE_AGE_MINUTES="10080"       # gift card rates are set by hand; allowed to be older
